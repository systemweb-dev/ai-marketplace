{
    "name": "example/billing",
    "description": "API e site de cobrança (fixture da sw-standards-php)",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "system-web/system-web-framework-core": "^1.11",
        "twig/twig": "~3.0",
        "nesbot/carbon": "^3.8",
        "php-curl-class/php-curl-class": "^11.0",
        "aws/aws-sdk-php": "^3.300"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app",
            "Middleware\\": "middleware",
            "Jobs\\": "jobs",
            "Scheduler\\": "scheduler"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
