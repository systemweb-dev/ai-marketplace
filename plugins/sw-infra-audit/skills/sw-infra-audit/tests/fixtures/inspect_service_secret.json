{
  "Spec": {
    "Name": "web",
    "Labels": {
      "secret-label": "zzz-label-should-not-leak",
      "traefik.http.routers.web.rule": "Host(`app.systemweb`)",
      "traefik.http.routers.web.entrypoints": "websecure",
      "traefik.http.middlewares.auth.basicauth.users": "admin:$apr1$hashedsecret-should-not-leak"
    },
    "TaskTemplate": {
      "ContainerSpec": {
        "Image": "web@sha256:abc",
        "Command": ["server"],
        "Args": ["--token", "abc123"],
        "Env": ["API_KEY=zzz"],
        "Labels": {"x": "y"},
        "User": "1000",
        "Mounts": [{"Type": "volume", "Source": "vol", "Target": "/data"}],
        "Privileges": {"Privileged": false}
      }
    },
    "EndpointSpec": {"Ports": [{"PublishedPort": 443, "TargetPort": 8443}]}
  }
}
