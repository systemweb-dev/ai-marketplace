{
  "Config": {
    "Image": "myapp:1.2",
    "User": "root",
    "Env": ["DB_PASSWORD=supersecret", "PORT=80"],
    "Labels": {"com.example.token": "tok-xyz-should-not-leak"},
    "Cmd": ["--password", "cli-secret-should-not-leak"],
    "Healthcheck": {"Test": ["CMD", "curl", "-u", "admin:hc-secret-should-not-leak"]}
  },
  "HostConfig": {"Privileged": false, "CapAdd": ["NET_ADMIN"],
                 "Sysctls": {"net.ipv4.secret": "sysctl-should-not-leak"}},
  "Mounts": [{"Type": "bind", "Source": "/data", "Destination": "/app/data"}],
  "NetworkSettings": {"Ports": {"80/tcp": [{"HostIp": "0.0.0.0", "HostPort": "8080"}]}}
}
